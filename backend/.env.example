# HiAnoter-Lite - Configuracoes de Ambiente
DATA_DIR=~/.hinoter-lite/data
MAX_UPLOAD_MB=300
THEME=system

# Transcricao (Whisper)
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small
WHISPER_DEVICE=auto
OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3-turbo

# Inteligencia Artificial (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Integracao com Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=
